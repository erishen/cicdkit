# 编译产物
/bin/
*.exe
# Java 构建产物（hello-java 示例的 mvn 输出，非源码）
examples/hello-java/target/

# 运行时数据（项目/运行记录存储）
/data/store.json
/data/*.json
/data-docker
/data-docker/*.json
# 外置运行日志（P4：<data_dir>/logs/run-<id>.log，随 run 增删；*.log 已覆盖，此处显式声明目录意图）
/data/logs/

# 本地配置（含密钥，禁止提交）
config.json
*.local.json
.env
.env.local

# 个人目标机配置（含真实云主机 IP，禁止提交；通用示例见 project.json）
examples/hello-cicd/project-tencent-cloud.json
examples/hello-node/project-tencent-cloud.json

# 日志
*.log

# 编辑器
.idea/
.vscode/
*.swp

# 系统文件
.DS_Store

# 预下载的 kubectl 二进制（仅供 Docker 构建 COPY，非源码、体积大，禁止提交）
kubectl-linux-arm64

# 前端依赖（Vite 安装产物，非源码）
cmd/server/web/node_modules/
# 前端构建产物（由 make build 经 `npm run build` 重新生成，无需提交）
cmd/server/web/dist/
.serena

# Rust 编译产物
**/target/

# Go 构建/模块/测试缓存 (沙箱内 GOCACHE/GOMODCACHE/GOPATH 指向本地 .gocache 目录)
.gocache/

# docker buildx 本地配置（BUILDX_CONFIG 指向此处，规避沙箱 buildx 活动追踪拦截；
# 含节点/活动元数据，非源码、体积随构建增长，禁止提交）
.buildx/

# Go 工具链本地缓存(沙箱 build/test 重定向到仓库根, 禁止提交)
.go-cache/
.go-gopath/
.go-tmp/
# Go 模块下载缓存(GOMODCACHE 重定向到仓库根, 含 toolchain 锁文件, 禁止提交)
.gomodcache/
