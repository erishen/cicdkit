<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 国内加速：华为云 NuGet 镜像，优先使用 -->
    <add key="huawei" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
    <!-- 官方源兜底，保障非国内网络仍可还原 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
