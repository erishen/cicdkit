# cicdkit —— SSH 部署连接配置（仅对 deploy.method=ssh 的项目生效）
#
# 用法：复制本文件为 .env 并填写；真实环境变量 / Shell 环境优先于本文件。
# 这些变量会在「项目 JSON 里对应字段为空」时自动补全，因此 UI 表单只需
# 选 ssh 并填 ssh_host，其余连接信息放这里即可（也方便换机器只改 .env）。
#
# 本文件不含任何真实凭据，可安全提交；真实值请写在 .env（已被 .gitignore 忽略）。

# 远端裸机 Docker 主机（必填；也可在项目里填 deploy.ssh_host）
# 例：CICD_SSH_HOST=203.0.113.10
CICD_SSH_HOST=<远端主机IP>

# 登录用户（必填）
# 例：CICD_SSH_USER=root
CICD_SSH_USER=<ssh用户名>

# 端口（默认 22；留空即 22）
CICD_SSH_PORT=22

# 私钥路径（平台走 ssh -i 密钥登录）
# 例：CICD_SSH_KEY_PATH=/Users/yourname/.ssh/id_rsa
CICD_SSH_KEY_PATH=<本机私钥绝对路径>

# 构建目标架构（单值）：ssh_transfer 部署到单台云主机时，本地构建该架构的镜像。
# 阿里云/腾讯云 CVM 多为 linux/amd64。注意：ssh 传输走 docker save → scp → docker load，
# 远端 docker load 无法加载多架构 OCI 索引，故只能填单值；多值会被代码截断为第一个。
# CICD_SSH_BUILD_PLATFORMS=linux/amd64

# 可选：覆盖容器名 / docker run 额外参数（通常留在项目 JSON 更直观）
# CICD_SSH_CONTAINER=hello-cicd
# CICD_SSH_RUN_ARGS=-p 8080:8080 --restart unless-stopped

# 可选：ssh 部署的服务探测端口（默认 8080）。探针地址自动推导为
# http://<CICD_SSH_HOST>:<本端口>，无需在项目 JSON 里写死真实主机 IP。
# CICD_SSH_PROBE_PORT=8080

# ── 服务端 API 鉴权 ──
# API_TOKEN：开启后浏览器首次访问会弹框输入（存 localStorage 免重复填），
# 所有 /api 请求需带此令牌；留空则本地 127.0.0.1 不强制鉴权。
# 注意：真实环境变量 / Shell 环境优先于本文件——若 Shell 已 export API_TOKEN，
# 本行将被跳过，请以 Shell 实际生效的值为准。
# 推荐用强随机值生成：python3 -c "import secrets;print(secrets.token_urlsafe(40))"
# 例：API_TOKEN=your_strong_random_token_here
API_TOKEN=<服务端访问令牌，建议用 secrets.token_urlsafe(40) 生成>
